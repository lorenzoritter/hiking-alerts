# Copy this file to .env and adjust as needed.

# Matches the default docker-compose.yml Postgres service. If you're using
# `npx prisma dev` instead, replace this with the connection string it prints.
DATABASE_URL="postgresql://hiking:hiking@localhost:5432/hiking_alerts?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-value-at-least-32-characters-long"
