{
  "name": "hiking-alerts-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "prebuild": "DOTENV_CONFIG_PATH=../.env prisma generate --config ../prisma.config.ts",
    "build": "tsc -p tsconfig.json && node scripts/fix-generated-imports.mjs",
    "start": "DOTENV_CONFIG_PATH=../.env node dist/worker/src/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bullmq": "^5.58.5",
    "dotenv": "^17.4.2",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
